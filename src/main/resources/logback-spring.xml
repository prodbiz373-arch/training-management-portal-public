<configuration>
  <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
  <include resource="org/springframework/boot/logging/logback/console-appender.xml"/>
  <!-- Default: safe JSON to stdout. A reviewed external logging.config may replace this. -->
  <appender name="AUDIT_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%msg%n</pattern></encoder>
  </appender>
  <logger name="SECURITY_AUDIT" level="INFO" additivity="false"><appender-ref ref="AUDIT_CONSOLE"/></logger>
  <root level="INFO"><appender-ref ref="CONSOLE"/></root>
</configuration>
